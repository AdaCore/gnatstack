prefix=@prefix@
build=@build@
EXEEXT=@EXEEXT@
BUILD_LIBIBERTY=@BUILD_LIBIBERTY@
MAYBE_DOC=@maybe_doc@

ifeq ($(BUILD_LIBIBERTY), yes)
  EXTRA=build-libiberty/libiberty.a
else
  EXTRA=
endif

bin/gnatstack$(EXEEXT): force $(EXTRA) 
	gnatmake -Pssat.gpr

all: bin/gnatstack$(EXEEXT) $(MAYBE_DOC)

doc:
	make -C docs/ug html latexpdf

build-libiberty/Makefile:
	mkdir -p build-libiberty
	(cd build-libiberty && ../binutils/libiberty/configure --build=$(build))

build-libiberty/libiberty.a: build-libiberty/Makefile
	(cd build-libiberty && make)

install: 
	if [ ! -d $(prefix) ]; then mkdir $(prefix); fi
	if [ ! -d $(prefix)/bin ]; then mkdir $(prefix)/bin; fi
	cp -p  bin/gnatstack$(EXEEXT) $(prefix)/bin
	if [ -d $(prefix)/share/examples/gnatstack ]; then \
	   rm -rf $(prefix)/share/examples/gnatstack; \
	fi
	mkdir -p $(prefix)/share/examples/gnatstack
	cp -r examples/* $(prefix)/share/examples/gnatstack
	if [ ! -d $(prefix)/share/doc/gnatstack ]; then \
	   mkdir -p $(prefix)/share/doc/gnatstack; \
	fi
	if [ -d docs/ug/_build/html ]; then \
	   if [ ! -d $(prefix)/share/doc/gnatstack/html ]; then \
	      mkdir -p $(prefix)/share/doc/gnatstack/html; \
	   fi; \
	   cp -p -r docs/ug/_build/html/* $(prefix)/share/doc/gnatstack/html; \
	   cp -p docs/ug/_static/adacore.css \
	      $(prefix)/share/doc/gnatstack/html/_static/; \
	fi
	if [ -f docs/ug/_build/latex/GNATstack.pdf ]; then \
	   cp -p docs/ug/_build/latex/GNATstack.pdf \
	   $(prefix)/share/doc/gnatstack/gnatstack_ug.pdf; \
	fi

.PHONY: force install all
