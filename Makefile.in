prefix=@prefix@
build=@build@
EXEEXT=@EXEEXT@
BUILD_LIBIBERTY=@BUILD_LIBIBERTY@
MAYBE_DOC=@maybe_doc@

ifeq ($(BUILD_LIBIBERTY), yes)
  EXTRA=build-libiberty/libiberty.a
else
  EXTRA=
endif

bin/gnatstack$(EXEEXT): force $(EXTRA) 
	gnatmake -Pssat.gpr

all: bin/gnatstack$(EXEEXT) $(MAYBE_DOC)

doc: docs/ug/gnatstack_ug.html docs/ug/gnatstack_ug.pdf  docs/ug/gnatstack_ug.txt

docs/ug/gnatstack_ug.html: docs/ug/gnatstack_ug.texi docs/ug/gfdl.texi
	(cd docs/ug && texi2html  gnatstack_ug.texi)
docs/ug/gnatstack_ug.pdf: docs/ug/gnatstack_ug.texi docs/ug/gfdl.texi
	(cd docs/ug && texi2pdf gnatstack_ug.texi)
docs/ug/gnatstack_ug.txt: docs/ug/gnatstack_ug.texi docs/ug/gfdl.texi
	makeinfo --force --no-headers --no-split -o $@ $<

build-libiberty/Makefile:
	mkdir -p build-libiberty
	(cd build-libiberty && ../binutils/libiberty/configure --build=$(build))

build-libiberty/libiberty.a: build-libiberty/Makefile
	(cd build-libiberty && make)

install: 
	if [ ! -d $(prefix) ]; then mkdir $(prefix); fi
	if [ ! -d $(prefix)/bin ]; then mkdir $(prefix)/bin; fi
	cp -p  bin/gnatstack$(EXEEXT) $(prefix)/bin
	if [ -d $(prefix)/share/examples/gnatstack ]; then \
	   rm -rf $(prefix)/share/examples/gnatstack; \
	fi
	mkdir -p $(prefix)/share/examples/gnatstack
	cp -r examples/* $(prefix)/share/examples/gnatstack
	if [ ! -d $(prefix)/share/doc/gnatstack ]; then \
	   mkdir -p $(prefix)/share/doc/gnatstack; \
	fi
	if [ -f docs/ug/gnatstack_ug.html ]; then \
	   cp -p docs/ug/gnatstack_ug.html $(prefix)/share/doc/gnatstack; \
	   chmod 644 $(prefix)/share/doc/gnatstack/gnatstack_ug.html; \
	fi
	if [ -f docs/ug/gnatstack_ug.pdf ]; then \
	   cp -p docs/ug/gnatstack_ug.pdf $(prefix)/share/doc/gnatstack; \
	   chmod 644 $(prefix)/share/doc/gnatstack/gnatstack_ug.pdf; \
	fi
	if [ -f docs/ug/gnatstack_ug.txt ]; then \
	   cp -p docs/ug/gnatstack_ug.txt $(prefix)/share/doc/gnatstack; \
	   chmod 644 $(prefix)/share/doc/gnatstack/gnatstack_ug.txt; \
	fi

.PHONY: force install all
