ADC_REVISION($Revision: 1.1 $)
AC_INIT(Makefile.in)

AC_CANONICAL_SYSTEM

EXEC_PREFIX="$prefix"
AC_PROG_CC(gcc)
AC_CHECK_TOOL(GNATBIND,gnatbind,"no")
if test ${GNATBIND} = "no"; then
   AC_MSG_ERROR(Ada compiler needed,1)
fi

AC_MSG_CHECKING([check if Ada compiler supports Ada 2005])
echo 'procedure conftest is begin null; end conftest;' > conftest.adb

command="${CC} -c -gnat05 ./conftest.adb > /dev/null 2>./conftest.out"
if AC_TRY_EVAL(command); then
   AC_MSG_RESULT(yes)
else
   AC_MSG_RESULT(no)
fi

AC_CHECK_TOOL(TEXI2HTML,texi2html)
AC_CHECK_TOOL(TEXI2PDF,texi2pdf)

if test ${TEXI2PDF} != "" -a ${TEXI2HTML} != ""; then
   maybe_doc=doc
else
   maybe_doc=""
fi
AC_SUBST(maybe_doc)
AC_SUBST(EXEEXT)
AC_SUBST(prefix)
AC_OUTPUT(Makefile)
