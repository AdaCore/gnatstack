project Ssat is

   for Main use ("ssat.adb");

   package Compiler is
      for Default_Switches ("ada") use ("-gnatf", "-g", "-gnata", "-gnatg", "-gnat05");
   end Compiler;

   package Builder is
      for Default_Switches ("ada") use ("-g");
   end Builder;

   package Ide is
      for Vcs_Kind use "Subversion";
   end Ide;

end Ssat;

