project Ssat is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("gnatstack.adb");

   package Compiler is
      for Default_Switches ("ada") use ("-gnatf", "-g", "-gnata", "-gnatg", "-gnat12");
   end Compiler;

   package Linker is
      for Default_Switches ("ada") use ("-liberty");
   end Linker;

   package Builder is
      for Default_Switches ("ada") use ("-g");
   end Builder;

   package Ide is
      for Vcs_Kind use "Subversion";
   end Ide;

end Ssat;

