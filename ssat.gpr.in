with "gnatcoll.gpr";

project Ssat is

   Libiberty_Path := external ("LIBIBERTY_PATH", "@LIBIBERTY_PATH@");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("gnatstack.adb");

   package Naming is
      for Specification ("Elf_Arch") use "elf_arch__32.ads";
   end Naming;

   package Compiler is
      for Default_Switches ("ada") use ("-gnatf", "-g", "-gnata", "-gnatg", "-gnat12");
   end Compiler;

   package Linker is
      for Default_Switches ("ada") use ("-L" & Libiberty_Path, "-liberty");
   end Linker;

   package Builder is
      for Default_Switches ("ada") use ("-g");
   end Builder;

   package Ide is
      for Vcs_Kind use "Subversion";
   end Ide;

end Ssat;

