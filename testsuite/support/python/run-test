#!/usr/bin/env gnatpython
"""Usage: run-test [options] test_dir

Run a test located in test_dir
"""

from gnatpython.ex import Run
from gnatpython.internal.excross import run_cross
from gnatpython.env import Env
from gnatpython.fileutils import cd, cp, rm, mkdir, unpack_archive
from gnatpython.main import Main
from gnatpython.testdriver import TestRunner, add_run_test_options

import logging
import os
import sys


class TestGNATstack(TestRunner):

    def compute_cmd_line(self, filesize_limit=36000):
        # No command line. Compute stack usage for each tests/test_name.ada
        pass

    def adjust_to_context(self):
        # Disable test.opt support
        pass

    def gnatmake(self, cmd):
        if Env().target.is_host:
            gnatmake = 'gnatmake'
        else:
            gnatmake = Env().target.platform + '-gnatmake'
        p = Run([gnatmake] + cmd, cwd=self.src_dir)
        logging.debug(p.out)

    def run(self):
        testsuite_dir = os.getcwd()
        # Extra flags for building the application
        self.src_dir = self.work_dir + '/src'
        if Env().target.platform in ('erc32-elf', 'leon-elf', 'leon3-elf'):
            extra_flags = "-I%s/support/target-support/sparc-elf" % testsuite_dir
        else:
            extra_flags = ""

        # Sometimes it it not possible to modify all the data in the part of the
        # stack that is being used. Therefore, we add an expected margin between
        # the amount of stack actually modified and the stack allocation.

        if Env().target.platform in ('erc32-elf', 'leon-elf', 'leon3-elf'):
            # On SPARC-based targets, the last frame which is called reserves
            # at least 96 bytes. The minimum stack frame contains 16-word window
            # save area, plus struct/union return pointer, plus 6 outgoing
            # parameters. These are only 92 bytes but the stack and frame pointer
            # require to be on a eight byte boundary, hence the minimum stack frame
            # size is 96 bytes.
            expected_margin = 96
        else:
            expected_margin = 0

        test_filename = os.path.basename(self.test)
        test_name, _ = os.path.splitext(test_filename)

        # Extract source code
        p = Run(['gnatchop', '-w', '-c', '-q', test_filename], cwd=self.src_dir, output=self.output)

        # Extract other files associated to the test, if they exist

        if os.path.exists(os.path.join('tests', test_name + '.tgz')):
            unpack_archive(os.path.join('tests', test_name + '.tgz'),
                           self.src_dir, remove_root_dir=False)

        # Compile
        cmd = ['-O1', '-gnatn', '-fcallgraph-info=su,da', '--RTS=zfp',
               '-I%s/support' % testsuite_dir,
               '-I%s/support/target-support/%s' % (testsuite_dir, Env().target.platform)]

        if extra_flags:
            cmd.append(extra_flags)
        cmd.append('test')
        self.gnatmake(cmd)
        assert os.path.exists(self.src_dir + '/test')
        p = run_cross([self.src_dir + '/test'], cwd=self.src_dir)
        actual_stack_usage = int(p.out.split()[-2])

        # Get GNATstack information
        p = Run(['gnatstack', '-q', '*.ci'], cwd=self.src_dir)
        max_stack_usage = 0
        computation_not_acurate = False
        for line in p.out.splitlines():
            if ': total' in line:
                max_stack_usage = line.split()[-2]
                if max_stack_usage.endswith('?'):
                    computation_not_acurate = True
                max_stack_usage = int(max_stack_usage.strip('?'))

        with open(self.output, 'a') as f:
            if actual_stack_usage:
                f.write("Stack used: %d\n" % actual_stack_usage)
            else:
                f.write("Unknown stack usage\n")

            if max_stack_usage:
                f.write("GNATstack maximum stack usage: %d bytes\n" % max_stack_usage)
            else:
                f.write("Unknown stack requirements\n")

            if max_stack_usage > 0 or actual_stack_usage > 0:
                dif = max_stack_usage - actual_stack_usage
                if dif < 0:
                    f.write("TEST ERROR: GNATstack did not compute "
                            "a big enough worst case\n")
                elif dif > expected_margin:
                    f.write("TEST ERROR: GNATstack did not compute "
                            "a tight worst case\n")
                elif computation_not_acurate:
                    f.write("TEST ERROR: GNATstack indicated computation not accurate\n")
                else:
                    f.write("TEST OK...\n")
            else:
                f.write("TEST ERROR: not enough information\n")

    def prepare_working_space(self):
        """Prepare working space

        REMARKS
          Set the working space in self.work_dir. This resets the working
          directory and copies the test into <work_dir>/src. This directory
          can be used to hold temp files as it will be automatically deleted
          at the end of the test by the clean method
        """
        # At this stage the test should be executed so start copying test
        # sources in a temporary location.
        rm(self.work_dir, True)
        mkdir(self.work_dir + '/src')
        cp(self.test, self.work_dir + '/src')

    def apply_output_filter(self, str_list):
        """Remove all output if TEST OK... is found
        """
        for line in str_list:
            if line.startswith("TEST OK..."):
                return []
        return str_list

    def set_output_filter(self):
        pass


def main():
    """Run a single test"""
    m = Main(add_targets_options=True)
    add_run_test_options(m)
    m.parse_args()
    if not m.args:
        sys.exit("Error: 1 argument expected. See -h")

    if m.options.restricted_discs is not None:
        m.options.restricted_discs = m.options.restricted_discs.split(',')
    t = TestGNATstack(
            m.args[0],
            m.options.discs,
            m.options.output_dir,
            m.options.tmp,
            m.options.enable_cleanup,
            m.options.restricted_discs,
            len(m.args) > 1 and m.args[1:] or None)

    t.execute()

if __name__ == '__main__':
    main()
